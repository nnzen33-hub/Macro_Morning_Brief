import os
import requests
from datetime import datetime
from openai import OpenAI
import smtplib
from email.mime.text import MIMEText

# -----------------------------
# ENVIRONMENT VARIABLES
# -----------------------------
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
NEWSAPI_KEY = os.getenv("NEWSAPI_KEY")
EMAIL_USERNAME = os.getenv("EMAIL_USERNAME")
EMAIL_PASSWORD = os.getenv("EMAIL_PASSWORD")
NOTIFY_EMAIL = os.getenv("NOTIFY_EMAIL")  # Your email (founder)

client = OpenAI(api_key=OPENAI_API_KEY)

# -----------------------------
# NEWS SOURCES (9 FEEDS)
# -----------------------------
SOURCES = {
    "Harvard Business Review": "https://newsapi.org/v2/everything?q=Harvard%20Business%20Review&sortBy=publishedAt",
    "McKinsey": "https://newsapi.org/v2/everything?q=McKinsey&sortBy=publishedAt",
    "MIT Technology Review": "https://newsapi.org/v2/everything?q=MIT%20Technology%20Review&sortBy=publishedAt",
    "MIT TR – AI Predictions": "https://newsapi.org/v2/everything?q=MIT%20AI%202026&sortBy=publishedAt",
    "Financial Times": "https://newsapi.org/v2/everything?q=Financial%20Times&sortBy=publishedAt",
    "The Economist": "https://newsapi.org/v2/everything?q=The%20Economist&sortBy=publishedAt",
    "Superhuman": "https://newsapi.org/v2/everything?q=Superhuman%20AI&sortBy=publishedAt",
    "The Deep View": "https://newsapi.org/v2/everything?q=%22The%20Deep%20View%22%20AI&sortBy=publishedAt",
    "The Rundown AI": "https://newsapi.org/v2/everything?q=%22The%20Rundown%20AI%22&sortBy=publishedAt"
}

# -----------------------------
# FETCH NEWS FROM NEWSAPI
# -----------------------------
def fetch_articles(url):
    full_url = f"{url}&apiKey={NEWSAPI_KEY}"
    response = requests.get(full_url)
    data = response.json()

    if "articles" not in data or len(data["articles"]) == 0:
        return "No articles found today."

    combined = "\n\n".join(
        f"Title: {a['title']}\nDescription: {a.get('description', '')}"
        for a in data["articles"][:5]
    )
    return combined

# -----------------------------
# SUMMARIZE WITH OPENAI
# -----------------------------
def summarize_text(source_name, text):
    prompt = f"""
    You are generating a 500-word founder-grade summary for the Morning Brief.
    Source: {source_name}
    Summarize the following content into a sharp, analytical, 500-word synthesis:

    {text}
    """

    completion = client.chat.completions.create(
        model="gpt-4.1",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.4
    )

    return completion.choices[0].message.content

# -----------------------------
# FINAL REFLECTION
# -----------------------------
def generate_final_reflection(all_summaries):
    prompt = f"""
    You are generating the final 500-word founder reflection for the Morning Brief.
    Synthesize the following summaries into a single, cohesive, strategic reflection:

    {all_summaries}
    """

    completion = client.chat.completions.create(
        model="gpt-4.1",
        messages=[{"role": "user", "content": prompt}],
        temperature=0.4
    )

    return completion.choices[0].message.content

# -----------------------------
# EMAIL DELIVERY — CLIENT
# -----------------------------
def send_client_email(subject, body):
    msg = MIMEText(body, "plain")
    msg["Subject"] = subject
    msg["From"] = EMAIL_USERNAME
    msg["To"] = "bneider@mac.com"

    with smtplib.SMTP_SSL("smtp.gmail.com", 465) as server:
        server.login(EMAIL_USERNAME, EMAIL_PASSWORD)
        server.sendmail(EMAIL_USERNAME, "bneider@mac.com", msg.as_string())

# -----------------------------
# EMAIL DELIVERY — FOUNDER NOTIFICATION
# -----------------------------
def send_notification_email(subject, body):
    msg = MIMEText(body, "plain")
    msg["Subject"] = subject
    msg["From"] = EMAIL_USERNAME
    msg["To"] = NOTIFY_EMAIL

    with smtplib.SMTP_SSL("smtp.gmail.com", 465) as server:
        server.login(EMAIL_USERNAME, EMAIL_PASSWORD)
        server.sendmail(EMAIL_USERNAME, NOTIFY_EMAIL, msg.as_string())

# -----------------------------
# MAIN WORKFLOW
# -----------------------------
def run_morning_brief():
    print("Fetching articles…")
    summaries = []

    for name, url in SOURCES.items():
        print(f"Processing: {name}")
        articles = fetch_articles(url)
        summary = summarize_text(name, articles)
        summaries.append(f"\n\n### {name}\n{summary}")

    combined = "\n\n".join(summaries)
    reflection = generate_final_reflection(combined)

    final_output = f"""
    MORNING BRIEF — {datetime.now().strftime('%B %d, %Y')}

    {combined}

    -------------------------
    FINAL REFLECTION
    -------------------------
    {reflection}
    """

    print("Sending full briefing to client…")
    send_client_email("Your Morning Brief", final_output)

    print("Sending notification to founder…")
    send_notification_email(
        f"Briefing Sent — {datetime.now().strftime('%B %d, %Y')}",
        "Your Morning Brief was successfully delivered to bneider@mac.com."
    )

    print("Done.")

if __name__ == "__main__":
    run_morning_brief()
